# Database & Redis Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_automation
REDIS_URL=redis://localhost:6379/0

# Security & Encryption Secrets
JWT_SECRET=super-secret-jwt-signing-key-replace-in-production-32bytes
ENCRYPTION_KEY=dGhpcy1pcy1hLXNhbXBsZS1mZXJuZXQta2V5LTMyYnl0ZXM9  # 32-byte base64 encoded Fernet key

# IMAP Monitoring Configuration
IMAP_POLL_INTERVAL=15

# Playwright Browser Configuration
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000
SCREENSHOT_ON_SUCCESS=false
SCREENSHOT_ON_FAILURE=true
SCREENSHOT_DIR=./screenshots

# Auto-Reply Delays (Seconds)
MIN_REPLY_DELAY=30
MAX_REPLY_DELAY=180

# Domain Allowlists & Rules (Comma-separated)
ALLOWED_SENDER_DOMAINS=example.com,greenarrow.internal,arrowmail.internal
ALLOWED_RECIPIENT_DOMAINS=test.example.com,internal.inbox
ALLOWED_CTA_DOMAINS=test.example.com,landing.arrowmail.internal

# Worker Concurrency Limits
MAX_CONCURRENT_WORKERS=5
CTA_WORKER_CONCURRENCY=3
REPLY_WORKER_CONCURRENCY=5
